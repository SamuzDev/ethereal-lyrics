# SPOTIFY CREDENTIALS
# Create a Spotify app at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_client_id_here
SPOTIFY_CLIENT_SECRET=your_client_secret_here
SPOTIFY_REDIRECT_URI=http://localhost:8888/callback

# MUSIXMATCH API (optional - for better quality synced lyrics)
# Get your free API key at: https://developer.musixmatch.com/
# Free tier: 2000 requests/day
MUSIXMATCH_API_KEY=

# GENIUS API (optional - for plain lyrics fallback)
# Get your access token at: https://genius.com/api-clients
GENIUS_ACCESS_TOKEN=

# LYRIC SYNC OFFSET (in milliseconds)
# Positive values = lyrics appear LATER (delay)
# Negative values = lyrics appear EARLIER (advance)
# Default: 1000 (delay to compensate for intros before vocals)
LYRIC_OFFSET_MS=1000
